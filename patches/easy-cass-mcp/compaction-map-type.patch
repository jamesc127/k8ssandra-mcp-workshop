@@ -84,6 +84,33 @@ class TestCassandraTable:
             assert strategy["options"]["max_threshold"] == "32"
             assert strategy["options"]["min_threshold"] == "4"
 
+    @pytest.mark.asyncio
+    async def test_get_compaction_strategy_driver_map_type(self, table):
+        """Real driver metadata returns OrderedMapSerializedKey, not dict.
+
+        Regression: a dict-only isinstance check made every table look like
+        STCS, so UCS tables were told to switch to UCS.
+        """
+        from cassandra.cqltypes import UTF8Type
+        from cassandra.util import OrderedMapSerializedKey
+
+        compaction = OrderedMapSerializedKey(UTF8Type, 5)
+        for k, v in {
+            "class": "org.apache.cassandra.db.compaction.UnifiedCompactionStrategy",
+            "scaling_parameters": "T4",
+        }.items():
+            compaction._insert_unchecked(k, UTF8Type.serialize(k, 5), v)
+        assert not isinstance(compaction, dict)
+
+        mock_metadata = Mock()
+        mock_metadata.options = {"compaction": compaction}
+
+        with patch.object(table, "_get_metadata", return_value=mock_metadata):
+            strategy = await table.get_compaction_strategy()
+
+            assert strategy["class"] == "UnifiedCompactionStrategy"
+            assert strategy["options"]["scaling_parameters"] == "T4"
+
     @pytest.mark.asyncio
     async def test_get_compaction_strategy_lcs(self, table):
         """Test getting LCS compaction strategy."""
